# 실제 값은 .env에 넣는다. .env는 절대 커밋하지 않는다.
# 로컬은 아래 기본값 그대로 두면 SQLite + LocMem으로 동작한다.
# 배포 서버용 값 예시는 deploy/README.md 참고.

# --- 공통 ---
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Netlify PR 미리보기처럼 주소가 매번 바뀌는 경우에만 사용 (배포 서버 전용)
CORS_ALLOWED_ORIGIN_REGEXES=
CORS_ALLOW_ALL_ORIGINS=False
# https로 열린 django-admin에 로그인하려면 필요 (배포 서버 전용)
CSRF_TRUSTED_ORIGINS=
DEFAULT_STORE_ID=s_mcm

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 저장소 (배포에서만 채운다) ---
# 비우면 SQLite/LocMem. 배포에서는 반드시 둘 다 채운다.
# REDIS_URL이 비면 워커 2개에서 화보 폴링이 404가 난다.
DATABASE_URL=
REDIS_URL=

# --- 업로드 스토리지 ---
# dev면 presign URL이 가짜다(계약 확인용). 실제 업로드는 s3 + 아래 값이 필요하다.
STORAGE_BACKEND=dev
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- 화보 ---
# 이미지 생성 벤더 실측 p50으로 교체할 것. 진행률 보간의 분모다.
LOOKBOOK_EXPECTED_SEC=25

# --- 배포 전용 (docker compose가 읽는다) ---
DOMAIN=
POSTGRES_DB=oando
POSTGRES_USER=oando
POSTGRES_PASSWORD=
